# Maintainer: instantOS <hello@instantos.io>
pkgname=instantmenu
pkgver=5.1.0
pkgrel=1
pkgdesc="A dynamic menu for X11 and Wayland"
arch=('x86_64')
url="https://github.com/instantOS/instantMENU"
license=('MIT')
depends=('bash' 'fontconfig' 'gcc-libs' 'glibc' 'libxcb' 'libxkbcommon-x11' 'perl')
makedepends=('cargo' 'rust')
optdepends=('i3-wm: launch desktop entries with instantmenu_smartrun desktop')
source=("$pkgname-$pkgver.tar.gz::https://github.com/instantOS/instantMENU/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

prepare() {
    cd "instantMENU-$pkgver"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "instantMENU-$pkgver"
    cargo build --frozen --release --bin instantmenu --bin itest
}

check() {
    cd "instantMENU-$pkgver"
    cargo test --frozen --all-targets
}

package() {
    cd "instantMENU-$pkgver"
    install -Dm755 target/release/instantmenu "$pkgdir/usr/bin/instantmenu"
    install -Dm755 target/release/itest "$pkgdir/usr/bin/itest"
    install -Dm755 instantmenu_path "$pkgdir/usr/bin/instantmenu_path"
    install -Dm755 instantmenu_run "$pkgdir/usr/bin/instantmenu_run"
    install -Dm755 instantmenu_smartrun "$pkgdir/usr/bin/instantmenu_smartrun"
    install -Dm644 instantmenu.1 "$pkgdir/usr/share/man/man1/instantmenu.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
